@model IEnumerable<clothing_be.Models.Others.StatusModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tags)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Districts)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Wards)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cities)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Users)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Orders)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Variations)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Categories)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentMethods)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ActivityLogs)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Type)
            </td>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.Tags)
            </td>
            <td>
                @Html.DisplayFor(model => item.Districts)
            </td>
            <td>
                @Html.DisplayFor(model => item.Wards)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cities)
            </td>
            <td>
                @Html.DisplayFor(model => item.Users)
            </td>
            <td>
                @Html.DisplayFor(model => item.Orders)
            </td>
            <td>
                @Html.DisplayFor(model => item.Variations)
            </td>
            <td>
                @Html.DisplayFor(model => item.Categories)
            </td>
            <td>
                @Html.DisplayFor(model => item.PaymentMethods)
            </td>
            <td>
                @Html.DisplayFor(model => item.ActivityLogs)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
