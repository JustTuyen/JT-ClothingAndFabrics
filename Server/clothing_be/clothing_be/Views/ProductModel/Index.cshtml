                @Html.DisplayFor(model => item.ImageGalleries)
            </td>
            <td>
                @Html.DisplayFor(model => item.ProductTags)
            </td>
            <td>
                @Html.DisplayFor(model => item.Comments)
            </td>
            <td>
                @Html.DisplayFor(model => item.Favorites)
            </td>
            <td>
                @Html.DisplayFor(model => item.Variations)
            </td>
